---
import type { MarkdownHeading } from "astro"

interface Props {
  headings: MarkdownHeading[]
}

const headings = Astro.props.headings.filter(({ depth }) => depth <= 4)
const firstDepth = Math.min(...headings.map(({ depth }) => depth))
---

{
  headings.length > 1 && (
    <nav aria-label="Table of contents" class="not-prose my-6">
      <details open>
        <summary class="cursor-pointer font-sans font-semibold">Table of contents</summary>
        <ul class="mb-0 mt-3 list-none space-y-1 p-0 text-sm leading-relaxed">
          {headings.map(({ depth, slug, text }) => (
            <li
              class:list={[
                depth === firstDepth + 1 && "ml-4",
                depth === firstDepth + 2 && "ml-8",
                depth >= firstDepth + 3 && "ml-12",
              ]}
            >
              <a class="text-foreground hover:underline" href={`#${slug}`}>
                {text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}
