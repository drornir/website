---
import type { MarkdownHeading } from "astro"
import type { CollectionEntry } from "astro:content"
import FormattedDate from "../components/FormattedDate.astro"
import TableOfContents from "../components/TableOfContents.astro"
import HTML from "./HTML.astro"

type Props = CollectionEntry<"blog">["data"] & { headings: MarkdownHeading[] }

const { title, description, date, updatedDate, cover, tags, headings } = Astro.props
---

<HTML
  head={{
    blog: Astro.props,
  }}
>
  <main class="mx-auto max-w-3xl px-4 py-8">
    <article>
      <div class="mx-auto">
        {
          cover.image && (
            <img
              class="mx-auto mb-8 block rounded-lg border border-foreground bg-white"
              src={(cover.image.startsWith("/") && cover.image) || "/" + cover.image}
              alt={cover.alt}
            />
          )
        }
        <!-- TODO Add caption from cover.caption -->
      </div>
      <div class="my-astro-content mx-auto">
        <div class="">
          <h1 class="my-8 text-4xl">{title}</h1>
          <div class="">
            {
              description && (
                <p>
                  <blockquote>{description}</blockquote>
                </p>
              )
            }
            <p>
              <FormattedDate date={date} />
            </p>
            {
              updatedDate && (
                <p>
                  <i>
                    Last updated on <FormattedDate date={updatedDate} />
                  </i>
                </p>
              )
            }
          </div>
          <ul class="not-prose flex flex-row flex-wrap text-sm text-secondary underline">
            {
              tags.map((tag) => (
                <li class="not-prose mx-1">
                  <a href={`/blog/tags/${tag}/`}>#{tag}</a>
                </li>
              ))
            }
          </ul>
          <hr />
        </div>

        <TableOfContents headings={headings} />
        <slot />
      </div>
    </article>
  </main>
</HTML>
